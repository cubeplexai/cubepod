{
  "name": "cubepod",
  "version": "0.4.0",
  "description": "Official TypeScript/JavaScript SDK for CubePod (E2B-compatible persistent MicroVM sandboxes)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src/",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "cubepod",
    "cubeplex",
    "e2b",
    "sandbox",
    "microvm",
    "ai-agents",
    "code-interpreter"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cubeplexai/cubepod.git",
    "directory": "sdks/typescript"
  },
  "homepage": "https://cubepod.cubeplex.ai",
  "bugs": {
    "url": "https://github.com/cubeplexai/cubepod/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
