# CubePod Firecracker official volume NFS client; built in, not user-image modules.
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_NFS_FS=y
CONFIG_NFS_V3=y
CONFIG_SUNRPC=y
# CONFIG_NFS_V4 is not set
# CONFIG_NFS_V2 is not set
# CONFIG_ROOT_NFS is not set
# CONFIG_NFSD is not set
CONFIG_LOCALVERSION="-cubepod-nfs1"
