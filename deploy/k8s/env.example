# Cluster profile for the live verification scripts.
# Copy to deploy/k8s/env.local (gitignored). make test-k8s-e2e,
# make test-k8s-block, and deploy/k8s/longhorn-v2/install.sh source that file.
#
# The cluster is whichever kubeconfig is current (KUBECONFIG or ~/.kube/config).
# Leave a variable unset to discover it. Nothing here is tied to one lab.

# Gateway HTTP address. Discovered from the gateway Service when empty.
# NodePort uses the gateway Pod's host IP, then the InternalIP of the first
# Ready schedulable node. Set CUBEPOD_NODE_IP when that address is not
# reachable from the machine running the tests.
# A Helm release whose Service is not named cubepod-gateway is found by the
# app.kubernetes.io/component=gateway label. Set the name when that is ambiguous.
# CUBEPOD_GATEWAY_URL=http://10.0.0.8:32380
# CUBEPOD_NODE_IP=10.0.0.8
# CUBEPOD_GATEWAY_NAME=cubepod-gateway

# CUBEPOD_SYSTEM_NAMESPACE=cubepod-system
# CUBEPOD_WORKLOADS_NAMESPACE=cubepod-workloads

# Image used as the sandbox and as the block-probe Pod. It must contain
# bash, blockdev, and stat. Discovered from -sandbox-image on the gateway
# or controller Deployment when empty. The scripts do not invent a registry.
# CUBEPOD_SANDBOX_IMAGE=example.com/sandbox:1
# Private registries: one pull secret name, applied to the prep Job and the probe Pod.
# CUBEPOD_IMAGE_PULL_SECRET=regcred

# StorageClass the lifecycle test expects on the two block PVCs.
# Discovered from -storage-class when empty.
# CUBEPOD_STORAGE_CLASS=longhorn-v2-block-thin

# Pin the block-probe Pod to one node. Leave empty to let the scheduler
# follow the volume's topology.
# CUBEPOD_SCHEDULE_NODE=worker-a

# Longhorn V2 installer. CUBEPOD_LONGHORN_NODE is required for install.sh.
# The disk path, image file, and size are passed into the prep Job and the
# Longhorn disk record. The defaults match a host that already uses
# /storage/cubepod. Set them before the first install on another machine,
# or a later run creates a second disk.
# CUBEPOD_LONGHORN_NODE=worker-a
# CUBEPOD_LONGHORN_NAMESPACE=longhorn-system
# CUBEPOD_PREP_IMAGE=example.com/sandbox:1
# CUBEPOD_LONGHORN_IMG=/var/lib/cubepod/longhorn-v2.img
# CUBEPOD_LONGHORN_DEV=/dev/cubepod/longhorn-v2
# CUBEPOD_LONGHORN_SIZE=80G
# CUBEPOD_HUGEPAGES=1024
# CUBEPOD_RESTART_KUBELET=0
