---
import Default from '@astrojs/starlight/components/Head.astro';
---

<Default {...Astro.props}><slot /></Default>

<script is:inline>
  // Clear any legacy preview palette override so Starlight's Dark (Oxide Copper) / Light (Option A) cleanly applies
  try {
    localStorage.removeItem('cp-palette');
    delete document.documentElement.dataset.cpPalette;
  } catch (e) {}
</script>

<script>
  import mermaid from 'mermaid';

  function getTheme() {
    return document.documentElement.dataset.theme === 'light' ? 'default' : 'dark';
  }

  async function renderMermaidBlocks() {
    const nodes = Array.from(document.querySelectorAll('pre.mermaid'));
    if (nodes.length === 0) return;

    const isLight = getTheme() === 'default';
    const styles = getComputedStyle(document.documentElement);
    const primary = styles.getPropertyValue('--cp-primary').trim() || (isLight ? '#ea580c' : '#f97316');
    const bg = styles.getPropertyValue('--cp-canvas').trim() || (isLight ? '#f8f7f4' : '#0e0e0d');
    const surface = styles.getPropertyValue('--cp-surface').trim() || (isLight ? '#ffffff' : '#161614');
    const text = styles.getPropertyValue('--cp-heading').trim() || (isLight ? '#111214' : '#f2f0ea');
    const line = styles.getPropertyValue('--cp-muted').trim() || (isLight ? '#52525b' : '#a8a49c');

    mermaid.initialize({
      startOnLoad: false,
      theme: isLight ? 'default' : 'dark',
      securityLevel: 'loose',
      themeVariables: {
        primaryColor: surface,
        primaryTextColor: text,
        primaryBorderColor: primary,
        lineColor: line,
        secondaryColor: surface,
        tertiaryColor: bg,
        background: bg,
      },
    });

    for (const el of nodes) {
      const raw = el.getAttribute('data-mermaid-src');
      if (raw) {
        el.removeAttribute('data-processed');
        el.textContent = raw;
      }
    }
    await mermaid.run({ nodes });
  }

  function init() {
    renderMermaidBlocks().catch(console.error);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  const observer = new MutationObserver((mutations) => {
    for (const m of mutations) {
      if (m.type === 'attributes' && m.attributeName === 'data-theme') {
        renderMermaidBlocks().catch(console.error);
        break;
      }
    }
  });
  observer.observe(document.documentElement, { attributes: true });
</script>
