  }

  .cp-sim-tab.is-active {
    background: var(--cp-primary-soft);
    color: var(--cp-primary);
    border-color: var(--cp-primary-border);
    font-weight: 600;
  }

  .cp-sim-stage {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cp-sim-compute {
    padding: 0.8rem 0.9rem;
    border-radius: 0.25rem;
    border: 1px solid var(--cp-border);
    background: var(--cp-surface-solid);
    transition: opacity 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
  }

  .cp-sim-card[data-state='suspend'] .cp-sim-compute {
    opacity: 0.48;
    border-style: dashed;
  }

  .cp-sim-card[data-state='fork'] .cp-sim-compute {
    border-color: var(--cp-primary-border);
    box-shadow: 4px 4px 0 -1px var(--cp-canvas), 4px 4px 0 0 var(--cp-primary-border);
  }

  .cp-sim-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .cp-sim-compute-title {
    font-family: var(--cp-font-display);
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--cp-heading);
  }

  .cp-sim-compute-meta {
    color: var(--cp-ok);
  }

  .cp-sim-card[data-state='suspend'] .cp-sim-compute-meta {
    color: var(--cp-muted);
  }

  .cp-sim-overlay {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 0.7rem;
    border-radius: 0.25rem;
    border: 1px solid var(--cp-border);
    background: var(--cp-well);
  }

  .cp-mono-primary {
    font-family: var(--sl-font-mono);
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--cp-primary);
  }

  /* Animated I/O Bus */
  .cp-sim-bus {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.65rem;
    height: 18px;
    padding-inline: 22%;
  }

  .cp-bus-lane {
    position: relative;
    width: 2px;
    height: 100%;
    margin-inline: auto;
    background: var(--cp-border);
    overflow: hidden;
  }

  .cp-bus-pulse {
    position: absolute;
    left: 0;
    width: 2px;
    height: 8px;
    background: var(--cp-primary);
    animation: cp-bus-flow 1.3s linear infinite;
  }

  .cp-bus-lane-sec .cp-bus-pulse {
    background: var(--cp-secondary);
    animation-delay: 0.45s;
  }

  .cp-sim-card[data-state='suspend'] .cp-bus-pulse {
    animation-play-state: paused;
    opacity: 0;
  }

  @keyframes cp-bus-flow {
    0% { top: -8px; opacity: 0; }
    30% { opacity: 1; }
    100% { top: 18px; opacity: 0; }
  }

  /* Persistent Volume Cards */
  .cp-sim-vols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    gap: 0.65rem;
  }

  @media (max-width: 540px) {
    .cp-sim-vols {
      grid-template-columns: 1fr;
    }
  }

  .cp-sim-vol {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    margin: 0;
    padding: 0.85rem;
    border-radius: 0.25rem;
    transition: border-color 0.25s ease, background 0.25s ease;
  }

  .cp-sim-vol-rootfs {
    border: 1px solid var(--cp-primary-border);
    background: var(--cp-primary-soft);
  }

  .cp-sim-vol-ws {
    border: 1px solid var(--cp-secondary-border);
    background: var(--cp-secondary-soft);
  }

  .cp-sim-vol-scan {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, var(--cp-primary-soft), transparent);
    transform: translateX(-100%);
    pointer-events: none;
  }

  .cp-sim-card[data-state='reset'] .cp-sim-vol-scan {
    animation: cp-scan 1.4s ease-in-out infinite;
  }

  @keyframes cp-scan {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }

  .cp-sim-card[data-state='reset'] .cp-sim-vol-ws {
    border-color: var(--cp-ok-border);
    background: var(--cp-ok-soft);
  }

  .cp-sim-vol-head {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 0.45rem;
  }

  .cp-sim-vol-head code {
    font-family: var(--sl-font-mono);
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--cp-heading);
    background: transparent;
    padding: 0;
  }

  .cp-sim-vol p {
    margin: 0;
    font-size: 0.76rem;
    line-height: 1.5;
    color: var(--cp-muted);
  }

  .cp-sim-banner {
    margin-top: 0.85rem;
    padding: 0.6rem 0.8rem;
    border-radius: 0.25rem;
    border: 1px solid var(--cp-border);
    background: var(--cp-well);
    font-family: var(--sl-font-mono);
    font-size: 0.74rem;
    line-height: 1.5;
    color: var(--cp-body);
  }

  .cp-text-primary { color: var(--cp-primary); }
  .cp-text-secondary { color: var(--cp-secondary); }
  .cp-text-ok { color: var(--cp-ok); }
  .cp-text-muted { color: var(--cp-muted); }

  /* ===================================================================== */
  /* METRICS STRIP                                                         */
  /* ===================================================================== */
  .cp-metrics-band {
    padding-block: 0;
  }

  .cp-metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding-inline: 0;
  }

  @media (max-width: 960px) {
    .cp-metrics-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .cp-metrics-grid {
      grid-template-columns: 1fr;
    }
  }

  .cp-metric-cell {
    padding: 1.75rem 1.75rem;
    border-right: 1px solid var(--cp-border);
    border-bottom: 1px solid var(--cp-border);
    transition: background 0.15s ease;
  }

  @media (min-width: 961px) {
    .cp-metric-cell { border-bottom: 0; }
    .cp-metric-cell:last-child { border-right: 0; }
  }

  .cp-metric-cell:hover {
    background: var(--cp-surface);
  }

  .cp-metric-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.85rem;
  }

  .cp-metric-dot {
    width: 7px;
    height: 7px;
    border-radius: 9999px;
    background: var(--cp-muted);
  }

  .cp-tone-primary .cp-metric-kpi,
  .cp-tone-primary .cp-metric-val { color: var(--cp-primary); }
  .cp-tone-primary .cp-metric-dot { background: var(--cp-primary); }

  .cp-tone-secondary .cp-metric-kpi,
  .cp-tone-secondary .cp-metric-val { color: var(--cp-secondary); }
  .cp-tone-secondary .cp-metric-dot { background: var(--cp-secondary); }

  .cp-tone-ok .cp-metric-kpi,
  .cp-tone-ok .cp-metric-val { color: var(--cp-ok); }
  .cp-tone-ok .cp-metric-dot { background: var(--cp-ok); }

  .cp-tone-neutral .cp-metric-kpi,
  .cp-tone-neutral .cp-metric-val { color: var(--cp-heading); }

  .cp-metric-val {
    font-family: var(--sl-font-mono);
    font-size: 1.8rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .cp-metric-title {
    font-family: var(--cp-font-display);
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--cp-heading);
    margin-top: 0.5rem;
  }

  .cp-metric-desc {
    margin: 0.3rem 0 0;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--cp-muted);
  }

  /* ===================================================================== */
  /* SECTION HEADS                                                         */
  /* ===================================================================== */
  .cp-head-split {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .cp-head-block {
    max-width: 44rem;
    margin-bottom: 2.25rem;
  }

  .cp-head-center {
    max-width: 40rem;
    margin-inline: auto;
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .cp-h2 {
    font-family: var(--cp-font-display);
    font-size: clamp(1.55rem, 2.6vw, 2.05rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--cp-heading);
    margin: 0;
  }

  .cp-sub {
    margin: 0.65rem 0 0;
    font-size: 0.96rem;
    line-height: 1.65;
    color: var(--cp-muted);
  }

  /* ===================================================================== */
  /* SPLIT SDK IDE + STREAMING DAEMON LOG CONSOLE                          */
  /* ===================================================================== */
  .cp-seg-tabs {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 0.25rem;
    padding: 0.25rem;
    background: var(--cp-well);
    border: 1px solid var(--cp-border);
    border-radius: 0.25rem;
  }

  .cp-seg-tab {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    min-height: 2.1rem;
    line-height: 1.2;
    border: 1px solid transparent;
    background: transparent;
    color: var(--cp-muted);
    font-family: var(--sl-font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    padding: 0.44rem 0.85rem;
    border-radius: 0.25rem;
    cursor: pointer;
    transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
  }

  .cp-seg-tab:hover {
    color: var(--cp-heading);
  }

  .cp-seg-tab.is-active {
    background: var(--cp-primary-soft);
    color: var(--cp-primary);
    border-color: var(--cp-primary-border);
    font-weight: 600;
  }

  .cp-ide-split {
    display: grid;
    grid-template-columns: 1.25fr 0.95fr;
    border: 1px solid var(--cp-border);
    border-radius: 0.375rem;
    background: var(--cp-well);
    overflow: hidden;
  }

  @media (max-width: 960px) {
    .cp-ide-split {
      grid-template-columns: 1fr;
    }
  }

  .cp-ide-code {
    border-right: 1px solid var(--cp-border);
    min-width: 0;
  }

  @media (max-width: 960px) {
    .cp-ide-code {
      border-right: 0;
      border-bottom: 1px solid var(--cp-border);
    }
  }

  .cp-term-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 2.95rem;
    padding: 0.5rem 1rem;
    background: var(--cp-surface);
    border-bottom: 1px solid var(--cp-border);
    box-sizing: border-box;
  }

  .cp-term-dots {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .cp-tdot {
    width: 9px;
    height: 9px;
    border-radius: 9999px;
    border: 1px solid var(--cp-border-active);
    background: var(--cp-surface-high);
  }

  .cp-term-file {
    margin-left: 0.45rem;
    font-family: var(--sl-font-mono);
    font-size: 0.76rem;
    color: var(--cp-muted);
  }

  .cp-term-meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .cp-term-btn {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    min-height: 1.7rem;
    line-height: 1;
    background: var(--cp-surface-high);
    border: 1px solid var(--cp-border);
    color: var(--cp-body);
    font-family: var(--sl-font-mono);
    font-size: 0.72rem;
    padding: 0.25rem 0.6rem;
    border-radius: 0.25rem;
    cursor: pointer;
  }

  .cp-term-btn:hover,
  .cp-term-btn.is-replaying {
    border-color: var(--cp-primary-border);
    color: var(--cp-primary);
  }

  .cp-term-body {
    padding: 1.35rem;
    overflow-x: auto;
  }

  .cp-code-pane {
    display: none;
    gap: 1.15rem;
    font-family: var(--sl-font-mono);
    font-size: 0.81rem;
    line-height: 1.65;
  }

  .cp-code-pane.is-active {
    display: flex;
  }

  .cp-gutter {
    display: flex;
    flex-direction: column;
    text-align: right;
    user-select: none;
    color: var(--cp-subtle);
  }

  .cp-pre {
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--cp-body);
    font-family: var(--sl-font-mono);
    font-size: 0.81rem;
    line-height: 1.65;
    flex: 1;
  }

  .cp-ide-logs {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--cp-well);
  }

  .cp-ide-logs .cp-term-file {
    margin-left: 0;
  }

  .cp-log-badge {
    display: inline-flex;
    align-items: center;
    min-height: 1.7rem;
    gap: 0.4rem;
    color: var(--cp-ok);
  }

  .cp-dot-ok {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: var(--cp-ok);
  }

  .cp-log-body {
    padding: 1.35rem 1.2rem 0.6rem;
    min-height: 11.5rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    font-family: var(--sl-font-mono);
    font-size: 0.76rem;
    line-height: 1.55;
  }

  .cp-log-body :global(.cp-log-line) {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .cp-log-body :global(.cp-log-line.is-visible) {
    opacity: 1;
    transform: translateY(0);
  }

  .cp-log-body :global(.cp-log-t) {
    color: var(--cp-subtle);
    flex-shrink: 0;
  }

  .cp-log-body :global(.cp-log-tag) {
    color: var(--cp-primary);
    font-weight: 600;
    flex-shrink: 0;
  }

  .cp-log-body :global(.cp-log-msg) {
    color: var(--cp-body);
  }

  .cp-log-cursor {
    padding: 0.35rem 1.2rem 1.25rem;
    font-family: var(--sl-font-mono);
    color: var(--cp-primary);
  }

  .cp-cursor-block {
    display: inline-block;
    animation: cp-blink 1s step-end infinite;
  }

  @keyframes cp-blink {
    50% { opacity: 0; }
  }

  /* ===================================================================== */
  /* 4-LAYER ARCHITECTURE STACK                                            */
  /* ===================================================================== */
  .cp-arch-stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cp-arch-band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.35rem 1.5rem;
    background: var(--cp-surface);
    border: 1px solid var(--cp-border);
    border-left-width: 4px;
    border-radius: 0.25rem;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .cp-arch-band:hover {
    background: var(--cp-surface-high);
  }

  .cp-arch-primary { border-left-color: var(--cp-primary); }
  .cp-arch-secondary { border-left-color: var(--cp-secondary); }
  .cp-arch-ok { border-left-color: var(--cp-ok); }

  .cp-arch-left {
    display: flex;
    align-items: center;
    gap: 1.15rem;
    flex: 1 1 28rem;
  }

  .cp-arch-num {
    font-family: var(--sl-font-mono);
    font-size: 1.35rem;
    font-weight: 700;
  }

  .cp-arch-primary .cp-arch-num { color: var(--cp-primary); }
  .cp-arch-secondary .cp-arch-num { color: var(--cp-secondary); }
  .cp-arch-ok .cp-arch-num { color: var(--cp-ok); }

  .cp-arch-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.3rem;
  }

  .cp-arch-title-row h3 {
    margin: 0;
    font-size: 1.04rem;
    font-weight: 600;
    color: var(--cp-heading);
  }

  .cp-arch-left p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--cp-muted);
  }

  .cp-tag {
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.45rem;
    border-radius: 0.25rem;
    border: 1px solid var(--cp-border);
    background: var(--cp-surface-high);
    color: var(--cp-muted);
  }

  .cp-tag-primary {
    color: var(--cp-primary);
    border-color: var(--cp-primary-border);
    background: var(--cp-primary-soft);
  }

  .cp-tag-secondary {
    color: var(--cp-secondary);
    border-color: var(--cp-secondary-border);
    background: var(--cp-secondary-soft);
  }

  .cp-tag-ok {
    color: var(--cp-ok);
    border-color: var(--cp-ok-border);
    background: var(--cp-ok-soft);
  }

  .cp-arch-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  /* ===================================================================== */
  /* BENTO GRID                                                            */
  /* ===================================================================== */
  .cp-bento-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  @media (max-width: 1024px) {
    .cp-bento-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 640px) {
    .cp-bento-grid { grid-template-columns: 1fr; }
  }

  .cp-bento-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.35rem;
    padding: 1.65rem;
    border-radius: 0.25rem;
    border: 1px solid var(--cp-border);
    background: var(--cp-surface);
    text-decoration: none !important;
    transition: border-color 0.18s ease, background 0.18s ease, transform 0.18s ease;
  }

  .cp-bento-card:hover {
    border-color: var(--cp-primary-border);
    background: var(--cp-surface-high);
    transform: translateY(-2px);
  }

  .cp-bento-icon-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .cp-bento-icon {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.25rem;
    border: 1px solid var(--cp-border);
    background: var(--cp-surface-high);
    color: var(--cp-primary);
  }

  .cp-bento-secondary .cp-bento-icon { color: var(--cp-secondary); }
  .cp-bento-ok .cp-bento-icon { color: var(--cp-ok); }
  .cp-bento-neutral .cp-bento-icon { color: var(--cp-heading); }

  .cp-bento-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.06rem;
    font-weight: 600;
    color: var(--cp-heading);
  }

  .cp-bento-card p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.65;
    color: var(--cp-muted);
  }

  .cp-bento-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.9rem;
    border-top: 1px solid var(--cp-border);
    font-family: var(--sl-font-mono);
    font-size: 0.74rem;
    color: var(--cp-primary);
  }

  .cp-bento-secondary .cp-bento-foot { color: var(--cp-secondary); }
  .cp-bento-ok .cp-bento-foot { color: var(--cp-ok); }
  .cp-bento-neutral .cp-bento-foot { color: var(--cp-muted); }

  /* ===================================================================== */
  /* COMPARISON MATRIX                                                     */
  /* ===================================================================== */
  .cp-matrix-wrap {
    border: 1px solid var(--cp-border);
    border-radius: 0.25rem;
    overflow-x: auto;
    background: var(--cp-surface);
  }

  .cp-matrix {
    display: table;
    width: 100%;
    min-width: 720px;
    table-layout: fixed;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.88rem;
  }

  .cp-matrix th,
  .cp-matrix td {
    padding: 1rem 1.15rem;
    border-bottom: 1px solid var(--cp-border);
  }

  .cp-matrix tbody tr:last-child td {
    border-bottom: 0;
  }

  .cp-matrix thead th {
    font-family: var(--sl-font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cp-muted);
    background: var(--cp-surface-solid);
  }

  .cp-col-highlight {
    background: var(--cp-primary-soft) !important;
    color: var(--cp-primary) !important;
    border-left: 1px solid var(--cp-primary-border);
    border-right: 1px solid var(--cp-primary-border);
  }

  .cp-cell-dim {
    font-weight: 600;
    color: var(--cp-heading);
  }

  .cp-cell-highlight {
    background: var(--cp-primary-soft);
    border-left: 1px solid var(--cp-primary-border);
    border-right: 1px solid var(--cp-primary-border);
    font-family: var(--sl-font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--cp-primary);
  }

  .cp-cell-muted {
    font-family: var(--sl-font-mono);
    font-size: 0.8rem;
    color: var(--cp-muted);
  }

  /* ===================================================================== */
  /* CTA & FOOTER                                                          */
  /* ===================================================================== */
  .cp-cta-panel {
    display: flex;
