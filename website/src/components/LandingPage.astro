            { label: 'CubePod Intro', href: `${prefix}/getting-started/introduction/` },
            { label: 'CubePlex', href: 'https://github.com/cubeplexai/cubeplex', ext: true },
            { label: 'CubeLoop', href: 'https://github.com/cubeplexai/cubeloop', ext: true },
          ],
        },
        {
          title: 'DOCS',
          links: [
            { label: 'Quickstart', href: `${prefix}/getting-started/quickstart/` },
            { label: 'Architecture', href: `${prefix}/concepts/architecture/` },
            { label: 'API Explorer', href: `${prefix}/api/` },
            { label: 'llms.txt', href: '/llms.txt' },
          ],
        },
        {
          title: 'SPECS',
          links: [
            { label: 'Zero-Trust Egress', href: `${prefix}/concepts/zero-trust-egress/` },
            { label: 'CEPs Index', href: `${prefix}/ceps/` },
            { label: 'CRDs Reference', href: `${prefix}/reference/crds/` },
            { label: 'Release v0.5.0', href: `${prefix}/changelog/0.5.0/` },
          ],
        },
      ],
      copyright: 'Apache 2.0 · CubePlex AI Infrastructure',
      statusNominal: 'v0.5.0 Docs & OpenAPI Synced',
    };

const snippets = {
  e2b: `export E2B_DOMAIN="127.0.0.1:8080"
export E2B_API_KEY="cpod_live_secret"

from e2b_code_interpreter import Sandbox

with Sandbox.create() as sbx:
    sbx.commands.run("pip install pandas matplotlib")
    res = sbx.run_code("import pandas as pd; pd.DataFrame({'a':[1,2,3]})")
    print(res.results[0].html)`,
  python: `from cubepod import AsyncCubePod

async with AsyncCubePod(base_url="http://127.0.0.1:8080") as cp:
    box = await cp.create(
        "cubeplex-ubuntu24-desktop",
        volume_key="agent-ws-042",
        secret_bindings=[{
            "env_name": "GITHUB_TOKEN",
            "placeholder": "cpodref_gh_readonly_01",
            "allowed_hosts": ["api.github.com"],
        }],
    )
    forked = await cp.fork(box.sandbox_id)
    await cp.reset_rootfs(box.sandbox_id)
    await cp.pause(box.sandbox_id)`,
  ts: `import { Sandbox } from 'cubepod';

const sbx = await Sandbox.create({
  baseUrl: 'http://127.0.0.1:8080',
  templateId: 'cubeplex-ubuntu24-desktop',
  volumeKey: 'agent-ws-042',
});

await sbx.files.archiveSync({ 'app/main.py': 'print("ok")\\n' }, { dest: '/workspace' });
const panel = await sbx.createEndpoint(8080, { expiresInSeconds: 3600 });
console.log('GUI Panel:', panel.url);
await sbx.pause();`,
  cli: `cubepod health
cubepod sandbox create --template cubeplex-ubuntu24-desktop
cubepod sandbox exec <id> "apt-get update && apt-get install -y ripgrep"
cubepod sandbox fork <id>
cubepod sandbox reset-rootfs <id>
cubepod sandbox pause <id>

# Expose sandbox tools via Model Context Protocol
cubepod mcp`,
};

const daemonLogs = {
  e2b: [
    { t: '0.038s', tag: 'WARMPOOL', msg: 'Claimed standby Kata MicroVM pod-wp-84a1 (<50ms)' },
    { t: '0.094s', tag: 'CSI-BLK ', msg: 'Attached /dev/cubepod-rootfs (ext4) + /dev/cubepod-workspace' },
    { t: '0.412s', tag: 'OVERLAY ', msg: 'pip install pandas matplotlib committed to RootFS upperdir' },
    { t: '0.680s', tag: 'KERNEL  ', msg: 'python3 kernel executed cell · 1 HTML table artifact captured' },
    { t: '0.715s', tag: 'READY   ', msg: 'State persisted on block PVC across suspend & wake' },
  ],
  python: [
    { t: '0.044s', tag: 'VOLUME  ', msg: 'Bound deterministic volumeKey="agent-ws-042" -> /workspace' },
    { t: '0.118s', tag: 'EGRESS  ', msg: 'Injected cpodref_gh_readonly_01 · mTLS vault armed (api.github.com)' },
    { t: '0.842s', tag: 'COW-FORK', msg: 'CSI VolumeSnapshot cloned both PVCs -> child sandbox ready' },
    { t: '1.190s', tag: 'RESET-OS', msg: 'rootfsGeneration bumped -> clean OS; /workspace untouched' },
    { t: '1.310s', tag: 'SUSPEND ', msg: 'sync + fsfreeze complete -> Pod deleted (0 CPU / 0 RAM)' },
  ],
  ts: [
    { t: '0.041s', tag: 'WARMPOOL', msg: 'MicroVM ready · volumeKey="agent-ws-042" attached (1000:1000)' },
    { t: '0.165s', tag: 'ARCHIVE ', msg: 'POST /files/archive-sync unpacked app/main.py -> /workspace' },
    { t: '0.290s', tag: 'PANEL   ', msg: 'Lazy Desktop Neko WebRTC (:8080) signed -> /panel/{jwt}/' },
    { t: '0.420s', tag: 'SUSPEND ', msg: 'Zero-Export suspend complete · host memory reclaimed' },
  ],
  cli: [
    { t: '0.012s', tag: 'HEALTH  ', msg: 'cubepod-gateway :8080 OK · controller :8081 OK · egress OK' },
    { t: '0.046s', tag: 'CREATE  ', msg: 'Claimed Kata MicroVM from PodWarmPool in 46ms' },
    { t: '0.860s', tag: 'FORK    ', msg: 'CoW clone created via CSI VolumeSnapshot in 860ms' },
    { t: '1.020s', tag: 'MCP     ', msg: 'JSON-RPC stdio server listening (exec, files, fork, panel)' },
  ],
};

const installCmds = {
  helm: {
    label: isZh ? 'Helm (GHCR OCI · K8s)' : 'Helm (GHCR OCI · K8s)',
    cmd: 'helm install cubepod oci://ghcr.io/cubeplexai/charts/cubepod -n cubepod-system --create-namespace',
  },
  compose: {
    label: isZh ? 'Docker Compose (本地)' : 'Docker Compose (Local)',
    cmd: 'docker compose -f deploy/docker-compose/docker-compose.yaml up -d --build',
  },
};
---

<div class="cp-otel not-content">
  <!-- ======================================================================= -->
  <!-- 1. HERO SPLIT + INTERACTIVE MICROVM LIFECYCLE SIMULATOR                 -->
  <!-- ======================================================================= -->
  <section class="cp-band cp-hero-band">
    <div class="cp-wrap cp-hero-grid">
      <div class="cp-hero-copy">
        <div class="cp-status-pill">
          <span class="cp-beacon" aria-hidden="true">
            <span class="cp-beacon-ping"></span>
            <span class="cp-beacon-dot"></span>
          </span>
          <span class="cp-caps">{copy.badge}</span>
        </div>

        <h1 class="cp-h1">
          <span class="cp-h1-rest">{copy.h1Rest}</span>
          <span class="cp-h1-accent">{copy.h1Accent}</span>
        </h1>

        <p class="cp-hero-subhead">{copy.heroSubhead}</p>

        <p class="cp-lead">{copy.subtitle}</p>

        <div class="cp-actions">
          <a href={`${prefix}/getting-started/quickstart/`} class="cp-btn cp-btn-primary">
            <span>{copy.ctaPrimary}</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
          <a href={`${prefix}/api/`} class="cp-btn cp-btn-secondary">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--cp-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="4 17 10 11 4 5"/><line x1="12" x2="20" y1="19" y2="19"/>
            </svg>
            <span>{copy.ctaSecondary}</span>
          </a>
          <a href="https://github.com/cubeplexai/cubepod" target="_blank" rel="noopener noreferrer" class="cp-btn cp-btn-ghost">
            <span>{copy.ctaGithub} ↗</span>
          </a>
        </div>

        <div class="cp-cmd-wrap" data-cp-cmd-wrap>
          <div class="cp-cmd-modes" role="tablist" aria-label={isZh ? '选择部署命令' : 'Select install command'}>
            <button
              type="button"
              role="tab"
              aria-selected="true"
              class="cp-cmd-mode is-active"
              data-cmd-value={installCmds.helm.cmd}
            >
              {installCmds.helm.label}
            </button>
            <button
              type="button"
              role="tab"
              aria-selected="false"
              class="cp-cmd-mode"
              data-cmd-value={installCmds.compose.cmd}
            >
              {installCmds.compose.label}
            </button>
          </div>
          <div class="cp-cmd-bar">
            <span class="cp-cmd-prompt">$</span>
            <input
              type="text"
              readonly
              value={installCmds.helm.cmd}
              aria-label="Quickstart install command"
              class="cp-cmd-input"
              data-cmd-input
            />
            <button
              type="button"
              class="cp-cmd-copy"
              data-copy-text={installCmds.helm.cmd}
              data-label-default={copy.copyLabel}
              data-label-done={copy.copiedLabel}
            >
              <span>{copy.copyLabel}</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Right: Interactive Lifecycle Simulator -->
      <div class="cp-sim-card" data-cp-sim data-state="running">
        <div class="cp-sim-head">
          <div class="cp-sim-title">
            <span class="cp-sim-led"></span>
            <span class="cp-caps">{copy.simTitle}</span>
          </div>
          <div class="cp-sim-head-right">
            <span class="cp-chip cp-sim-pill" data-sim-pill>{copy.simStates[0].pill}</span>
            <button type="button" class="cp-sim-auto is-playing" data-sim-auto aria-pressed="true">
              <span class="cp-sim-auto-dot"></span>
              <span>{copy.simAuto}</span>
            </button>
          </div>
        </div>

        <!-- Lifecycle Stage Tabs -->
        <div class="cp-sim-tabs" role="tablist">
          {copy.simStates.map((st, idx) => (
            <button
              type="button"
              role="tab"
              class={`cp-sim-tab ${idx === 0 ? 'is-active' : ''}`}
              aria-selected={idx === 0 ? 'true' : 'false'}
              data-sim-target={st.id}
            >
              {st.label}
            </button>
          ))}
        </div>

        <!-- Animated Compute + OverlayFS + Dual Block Layers -->
        <div class="cp-sim-stage">
          <!-- Compute / Kata Pod Layer -->
          <div class="cp-sim-compute">
            <div class="cp-sim-row">
              <span class="cp-sim-compute-title" data-sim-compute-title>{copy.simStates[0].computeTitle}</span>
              <span class="cp-caps cp-sim-compute-meta" data-sim-compute-meta>{copy.simStates[0].computeMeta}</span>
            </div>
            <div class="cp-sim-overlay">
              <span class="cp-mono-primary" data-sim-root-title>{copy.simStates[0].rootTitle}</span>
              <span class="cp-caps cp-text-muted" data-sim-root-meta>{copy.simStates[0].rootMeta}</span>
            </div>
          </div>

          <!-- Animated I/O Bus Lines -->
          <div class="cp-sim-bus" aria-hidden="true">
            <div class="cp-bus-lane"><span class="cp-bus-pulse"></span></div>
            <div class="cp-bus-lane cp-bus-lane-sec"><span class="cp-bus-pulse"></span></div>
          </div>

          <!-- Persistent Dual CSI Raw Block PVCs -->
          <div class="cp-sim-vols">
            <div class="cp-sim-vol cp-sim-vol-rootfs">
              <div class="cp-sim-vol-scan" aria-hidden="true"></div>
              <div class="cp-sim-vol-head">
                <code>/dev/cubepod-rootfs</code>
                <span class="cp-caps cp-text-primary" data-sim-rootfs-state>{copy.simStates[0].rootfsState}</span>
              </div>
              <p data-sim-rootfs-note>{copy.simStates[0].rootfsNote}</p>
            </div>

            <div class="cp-sim-vol cp-sim-vol-ws">
              <div class="cp-sim-vol-head">
                <code>/dev/cubepod-workspace</code>
                <span class="cp-caps cp-text-secondary" data-sim-ws-state>{copy.simStates[0].wsState}</span>
              </div>
              <p data-sim-ws-note>{copy.simStates[0].wsNote}</p>
            </div>
          </div>
        </div>

        <div class="cp-sim-banner" data-sim-banner>
          {copy.simStates[0].banner}
        </div>
      </div>
    </div>
  </section>

  <!-- ======================================================================= -->
  <!-- 2. WIREFRAME METRICS STRIP (Clean & Breathable)                         -->
  <!-- ======================================================================= -->
  <section class="cp-band cp-metrics-band">
    <div class="cp-wrap cp-metrics-grid">
      {copy.metrics.map((m, i) => (
        <div class={`cp-metric-cell cp-tone-${m.tone} cp-reveal`} style={`--delay:${i * 70}ms`}>
          <div class="cp-metric-top">
            <span class="cp-caps cp-metric-kpi">{m.kpi}</span>
            <span class="cp-metric-dot" aria-hidden="true"></span>
          </div>
          <div class="cp-metric-val">{m.value}</div>
          <div class="cp-metric-title">{m.title}</div>
          <p class="cp-metric-desc">{m.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ======================================================================= -->
  <!-- 3. SDK CODE + STREAMING PODD DAEMON LOG CONSOLE                         -->
  <!-- ======================================================================= -->
  <section class="cp-band cp-surface-band" id="quickstart">
    <div class="cp-wrap">
      <div class="cp-head-split">
        <div>
          <div class="cp-eyebrow">{copy.sdkEyebrow}</div>
          <h2 class="cp-h2">{copy.sdkTitle}</h2>
          <p class="cp-sub">{copy.sdkSubtitle}</p>
        </div>
        <div class="cp-seg-tabs" role="tablist" data-cp-tabs>
          {copy.tabs.map((tab, idx) => (
            <button
              type="button"
              role="tab"
              class={`cp-seg-tab ${idx === 0 ? 'is-active' : ''}`}
              aria-selected={idx === 0 ? 'true' : 'false'}
              data-tab-target={tab.id}
              data-tab-file={tab.file}
            >
              {tab.label}
            </button>
          ))}
        </div>
      </div>

      <div class="cp-ide-split cp-reveal" data-cp-terminal>
        <!-- Left: Code Pane -->
        <div class="cp-ide-code">
          <div class="cp-term-bar">
            <div class="cp-term-dots">
              <span class="cp-tdot"></span>
              <span class="cp-tdot"></span>
              <span class="cp-tdot"></span>
              <span class="cp-term-file" data-term-file>{copy.tabs[0].file}</span>
            </div>
            <div class="cp-term-meta">
              <button type="button" class="cp-term-btn" data-term-replay>▶ {copy.replayLabel}</button>
              <button
                type="button"
                class="cp-term-btn"
                data-term-copy
                data-label-default={copy.copyLabel}
                data-label-done={copy.copiedLabel}
              >
                {copy.copyLabel}
              </button>
            </div>
          </div>

          <div class="cp-term-body">
            {Object.entries(snippets).map(([id, code], idx) => {
              const lines = code.split('\n');
              return (
                <div class={`cp-code-pane ${idx === 0 ? 'is-active' : ''}`} data-tab-panel={id}>
                  <div class="cp-gutter" aria-hidden="true">
                    {lines.map((_, i) => (
                      <span>{String(i + 1).padStart(2, '0')}</span>
                    ))}
                  </div>
                  <pre class="cp-pre"><code>{code}</code></pre>
                </div>
              );
            })}
          </div>
        </div>

        <!-- Right: Streaming Daemon Output -->
        <div class="cp-ide-logs">
          <div class="cp-term-bar">
            <span class="cp-term-file">{copy.logHeader}</span>
            <span class="cp-log-badge">
              <span class="cp-dot-ok"></span>
              <span class="cp-caps">{copy.logStatus}</span>
            </span>
          </div>
          <div class="cp-log-body" data-log-body aria-live="polite">
            {daemonLogs.e2b.map((line) => (
              <div class="cp-log-line is-visible">
                <span class="cp-log-t">[{line.t}]</span>
                <span class="cp-log-tag">{line.tag}</span>
                <span class="cp-log-msg">{line.msg}</span>
              </div>
            ))}
          </div>
          <div class="cp-log-cursor">
            <span class="cp-cursor-block">_</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================================================================= -->
  <!-- 4. FOUR-LAYER ARCHITECTURE STACK (Crisp Scannable Bands)                -->
  <!-- ======================================================================= -->
  <section class="cp-band" id="architecture">
    <div class="cp-wrap">
      <div class="cp-head-block">
        <div class="cp-eyebrow">{copy.archEyebrow}</div>
        <h2 class="cp-h2">{copy.archTitle}</h2>
        <p class="cp-sub">{copy.archSubtitle}</p>
      </div>

      <div class="cp-arch-stack">
        {copy.layers.map((layer, i) => (
          <div class={`cp-arch-band cp-arch-${layer.tone} cp-reveal`} style={`--delay:${i * 75}ms`}>
            <div class="cp-arch-left">
              <span class="cp-arch-num">{layer.num}</span>
              <div>
                <div class="cp-arch-title-row">
                  <h3>{layer.name}</h3>
                  <span class={`cp-tag cp-tag-${layer.tone}`}>{layer.tag}</span>
                </div>
                <p>{layer.desc}</p>
              </div>
            </div>
            <div class="cp-arch-chips">
              {layer.chips.map((c) => (
                <span class="cp-chip">{c}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ======================================================================= -->
  <!-- 5. SIX-CARD BENTO GRID (Generous Whitespace, Concise Copy)              -->
  <!-- ======================================================================= -->
  <section class="cp-band cp-surface-band" id="features">
    <div class="cp-wrap">
      <div class="cp-head-center">
        <div class="cp-eyebrow">{copy.bentoEyebrow}</div>
        <h2 class="cp-h2">{copy.bentoTitle}</h2>
        <p class="cp-sub">{copy.bentoSubtitle}</p>
      </div>

      <div class="cp-bento-grid">
        {copy.features.map((f, i) => (
          <a href={f.href} class={`cp-bento-card cp-bento-${f.tone} cp-reveal`} style={`--delay:${i * 60}ms`}>
            <div>
              <div class="cp-bento-icon-row">
                <div class="cp-bento-icon" aria-hidden="true">
                  {f.icon === 'storage' && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/></svg>
                  )}
                  {f.icon === 'pause' && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="10" x2="10" y1="15" y2="9"/><line x1="14" x2="14" y1="15" y2="9"/></svg>
                  )}
                  {f.icon === 'fork' && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><circle cx="18" cy="6" r="3"/><path d="M18 9v2c0 .6-.4 1-1 1H7c-.6 0-1-.4-1-1V9"/><path d="M12 12v3"/></svg>
                  )}
                  {f.icon === 'shield' && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
                  )}
                  {f.icon === 'desktop' && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>
                  )}
                  {f.icon === 'hub' && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v4"/><path d="m16.2 7.8 2.9-2.9"/><path d="M18 12h4"/><path d="m16.2 16.2 2.9 2.9"/><path d="M12 18v4"/><path d="m4.9 19.1 2.9-2.9"/><path d="M2 12h4"/><path d="m4.9 4.9 2.9 2.9"/><circle cx="12" cy="12" r="3"/></svg>
                  )}
                </div>
                <span class="cp-tag">{f.tag}</span>
              </div>
              <h3>{f.title}</h3>
              <p>{f.desc}</p>
            </div>
            <div class="cp-bento-foot">
              <span>{f.foot}</span>
              <span aria-hidden="true">→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ======================================================================= -->
  <!-- 6. CONCISE COMPARISON MATRIX                                            -->
  <!-- ======================================================================= -->
  <section class="cp-band">
    <div class="cp-wrap">
      <div class="cp-head-block">
        <div class="cp-eyebrow">{copy.compareEyebrow}</div>
        <h2 class="cp-h2">{copy.compareTitle}</h2>
      </div>

      <div class="cp-matrix-wrap cp-reveal">
        <table class="cp-matrix">
          <colgroup>
            <col style="width: 19%;" />
            <col style="width: 31%;" />
            <col style="width: 25%;" />
            <col style="width: 25%;" />
          </colgroup>
          <thead>
            <tr>
              <th>{copy.compareHeaders[0]}</th>
              <th class="cp-col-highlight">{copy.compareHeaders[1]}</th>
              <th>{copy.compareHeaders[2]}</th>
              <th>{copy.compareHeaders[3]}</th>
            </tr>
          </thead>
          <tbody>
            {copy.compareRows.map((row) => (
              <tr>
                <td class="cp-cell-dim">{row[0]}</td>
                <td class="cp-cell-highlight">{row[1]}</td>
                <td class="cp-cell-muted">{row[2]}</td>
                <td class="cp-cell-muted">{row[3]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ======================================================================= -->
  <!-- 7. ECOSYSTEM CTA BANNER & FOOTER                                        -->
  <!-- ======================================================================= -->
  <section class="cp-band cp-surface-band">
    <div class="cp-wrap">
      <div class="cp-cta-panel cp-reveal">
        <div class="cp-cta-body">
          <div class="cp-eyebrow">{copy.ecoEyebrow}</div>
          <h2 class="cp-h2">{copy.ecoTitle}</h2>
          <p class="cp-sub">
            {isZh ? (
              <>
                采用<strong>脑手解耦（Brain-Hands Decoupling）</strong>架构：上层「脑」由{' '}
                <a href="https://github.com/cubeplexai/cubeplex" class="cp-eco-link" target="_blank" rel="noopener noreferrer">
                  CubePlex
                </a>
                （团队 Agent 工作空间）与{' '}
                <a href="https://github.com/cubeplexai/cubeloop" class="cp-eco-link" target="_blank" rel="noopener noreferrer">
                  CubeLoop
                </a>
