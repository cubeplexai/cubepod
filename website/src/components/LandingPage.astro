<script is:inline define:vars={{ simStates: copy.simStates, daemonLogs }}>
  function copyTextToClipboard(text) {
    if (navigator.clipboard && window.isSecureContext) {
      return navigator.clipboard.writeText(text);
    }
    return new Promise((resolve, reject) => {
      try {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        const ok = document.execCommand('copy');
        document.body.removeChild(ta);
        if (ok) resolve();
        else reject(new Error('copy failed'));
      } catch (err) {
        reject(err);
      }
    });
  }

  // 1. Install mode switcher + Copy command button
  const cmdWrap = document.querySelector('[data-cp-cmd-wrap]');
  if (cmdWrap) {
    const cmdInput = cmdWrap.querySelector('[data-cmd-input]');
    const cmdCopy = cmdWrap.querySelector('[data-copy-text]');
    const cmdModes = cmdWrap.querySelectorAll('[data-cmd-value]');
    cmdModes.forEach((modeBtn) => {
      modeBtn.addEventListener('click', () => {
        const val = modeBtn.getAttribute('data-cmd-value') || '';
        cmdModes.forEach((m) => {
          const active = m === modeBtn;
          m.classList.toggle('is-active', active);
          m.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        if (cmdInput) cmdInput.value = val;
        if (cmdCopy) cmdCopy.setAttribute('data-copy-text', val);
      });
    });
  }

  document.querySelectorAll('[data-copy-text]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const text = btn.getAttribute('data-copy-text') || '';
      const span = btn.querySelector('span');
      const def = btn.getAttribute('data-label-default') || 'Copy';
      const done = btn.getAttribute('data-label-done') || 'Copied';
      copyTextToClipboard(text).then(() => {
        if (span) span.textContent = done;
        setTimeout(() => {
          if (span) span.textContent = def;
        }, 1600);
      });
    });
  });

  // 2. Hero Interactive MicroVM Lifecycle Simulator
  const simCard = document.querySelector('[data-cp-sim]');
  if (simCard && Array.isArray(simStates)) {
    const simTabs = Array.from(simCard.querySelectorAll('[data-sim-target]'));
    const autoBtn = simCard.querySelector('[data-sim-auto]');
    const elPill = simCard.querySelector('[data-sim-pill]');
    const elComputeTitle = simCard.querySelector('[data-sim-compute-title]');
    const elComputeMeta = simCard.querySelector('[data-sim-compute-meta]');
    const elRootTitle = simCard.querySelector('[data-sim-root-title]');
    const elRootMeta = simCard.querySelector('[data-sim-root-meta]');
    const elRootfsState = simCard.querySelector('[data-sim-rootfs-state]');
    const elRootfsNote = simCard.querySelector('[data-sim-rootfs-note]');
    const elWsState = simCard.querySelector('[data-sim-ws-state]');
    const elWsNote = simCard.querySelector('[data-sim-ws-note]');
    const elBanner = simCard.querySelector('[data-sim-banner]');

    let currentIdx = 0;
    let autoPlay = !window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
    let timer = null;

    function applySimState(idx) {
      currentIdx = idx;
      const st = simStates[idx];
      if (!st) return;
      simCard.setAttribute('data-state', st.id);
      simTabs.forEach((t, i) => {
        const active = i === idx;
        t.classList.toggle('is-active', active);
        t.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      if (elPill) elPill.textContent = st.pill;
      if (elComputeTitle) elComputeTitle.textContent = st.computeTitle;
      if (elComputeMeta) elComputeMeta.textContent = st.computeMeta;
      if (elRootTitle) elRootTitle.textContent = st.rootTitle;
      if (elRootMeta) elRootMeta.textContent = st.rootMeta;
      if (elRootfsState) elRootfsState.textContent = st.rootfsState;
      if (elRootfsNote) elRootfsNote.textContent = st.rootfsNote;
      if (elWsState) elWsState.textContent = st.wsState;
      if (elWsNote) elWsNote.textContent = st.wsNote;
      if (elBanner) elBanner.textContent = st.banner;
    }

    function stopAuto() {
      autoPlay = false;
      if (timer) clearInterval(timer);
      timer = null;
      if (autoBtn) {
        autoBtn.classList.remove('is-playing');
        autoBtn.setAttribute('aria-pressed', 'false');
      }
    }

    function startAuto() {
      if (timer) clearInterval(timer);
      autoPlay = true;
      if (autoBtn) {
        autoBtn.classList.add('is-playing');
        autoBtn.setAttribute('aria-pressed', 'true');
      }
      timer = setInterval(() => {
        applySimState((currentIdx + 1) % simStates.length);
      }, 3800);
    }

    simTabs.forEach((btn, idx) => {
      btn.addEventListener('click', () => {
        stopAuto();
        applySimState(idx);
      });
    });

    if (autoBtn) {
      autoBtn.addEventListener('click', () => {
        if (autoPlay) stopAuto();
        else startAuto();
      });
    }

    if (autoPlay) startAuto();
    else stopAuto();
  }

  // 3. SDK Switcher + Streaming Daemon Log Replay
  const tabWrap = document.querySelector('[data-cp-tabs]');
  const termWrap = document.querySelector('[data-cp-terminal]');
  if (tabWrap && termWrap) {
    const tabs = tabWrap.querySelectorAll('[data-tab-target]');
    const panels = termWrap.querySelectorAll('[data-tab-panel]');
    const fileEl = termWrap.querySelector('[data-term-file]');
    const copyBtn = termWrap.querySelector('[data-term-copy]');
    const replayBtn = termWrap.querySelector('[data-term-replay]');
    const logBody = termWrap.querySelector('[data-log-body]');
    let currentTab = 'e2b';
    let logTimers = [];

    function streamLogs(tabId) {
      if (!logBody) return;
      logTimers.forEach((id) => clearTimeout(id));
      logTimers = [];
      const entries = daemonLogs[tabId] || [];
      logBody.innerHTML = '';

      const reduced = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
      if (replayBtn) {
        replayBtn.classList.toggle('is-replaying', !reduced && entries.length > 0);
      }

      entries.forEach((entry, idx) => {
        const delay = reduced ? 0 : 90 + idx * 280;
        const tid = setTimeout(() => {
          const row = document.createElement('div');
          row.className = 'cp-log-line';

          const tSpan = document.createElement('span');
          tSpan.className = 'cp-log-t';
          tSpan.textContent = `[${entry.t}]`;

          const tagSpan = document.createElement('span');
          tagSpan.className = 'cp-log-tag';
          tagSpan.textContent = entry.tag;

          const msgSpan = document.createElement('span');
          msgSpan.className = 'cp-log-msg';
          msgSpan.textContent = entry.msg;

          row.append(tSpan, tagSpan, msgSpan);
          logBody.appendChild(row);

          if (reduced) {
            row.classList.add('is-visible');
          } else {
            requestAnimationFrame(() => {
              requestAnimationFrame(() => {
                row.classList.add('is-visible');
              });
            });
          }

          if (idx === entries.length - 1 && replayBtn) {
            const doneTid = setTimeout(() => {
              replayBtn.classList.remove('is-replaying');
            }, 300);
            logTimers.push(doneTid);
          }
        }, delay);
        logTimers.push(tid);
      });
    }

    tabs.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-tab-target') || 'e2b';
        const file = btn.getAttribute('data-tab-file');
        currentTab = target;
        tabs.forEach((t) => {
          const active = t === btn;
          t.classList.toggle('is-active', active);
          t.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        panels.forEach((p) => {
          p.classList.toggle('is-active', p.getAttribute('data-tab-panel') === target);
        });
        if (fileEl && file) fileEl.textContent = file;
        streamLogs(target);
      });
    });

    if (replayBtn) {
      replayBtn.addEventListener('click', () => streamLogs(currentTab));
    }

    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const activeCode = termWrap.querySelector('.cp-code-pane.is-active code');
        if (!activeCode) return;
        const def = copyBtn.getAttribute('data-label-default') || 'Copy';
        const done = copyBtn.getAttribute('data-label-done') || 'Copied';
        copyTextToClipboard(activeCode.textContent || '').then(() => {
          copyBtn.textContent = done;
          setTimeout(() => {
            copyBtn.textContent = def;
          }, 1600);
        });
      });
    }
  }

  // 4. Scroll Reveal Observer
  const reveals = document.querySelectorAll('.cp-reveal');
  if ('IntersectionObserver' in window && !window.matchMedia?.('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -30px 0px' }
    );
    reveals.forEach((el) => io.observe(el));
  } else {
    reveals.forEach((el) => el.classList.add('is-in'));
  }
</script>

